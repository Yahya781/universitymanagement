@model IEnumerable<universitymanagementsystem.Models.Department>

@{
    ViewData["Title"] = "Department Management";
}

<div class="content-header">
    <div class="container-fluid">

        <div class="row mb-3">

            <div class="col-sm-6">
                <h2>
                    <i class="fas fa-building"></i>
                    Department Management
                </h2>
            </div>

            <div class="col-sm-6 text-right">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Add Department
                </a>
            </div>

        </div>

        <div class="card mb-4">
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="input-group">
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name...">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-secondary">Search</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<section class="content">

    <div class="container-fluid">

        <!-- Statistics Card -->

        <div class="row mb-3">

            <div class="col-lg-3 col-6">

                <div class="small-box bg-info">

                    <div class="inner">
                        <h3>@Model.Count()</h3>
                        <p>Total Departments</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-building"></i>
                    </div>

                </div>

            </div>

        </div>

        <!-- Table Card -->

        <div class="card">

            <div class="card-header">

                <h3 class="card-title">
                    Department List
                </h3>

                <div class="card-tools">

                    <input type="text"
                           class="form-control"
                           placeholder="Search (Coming Soon)"
                           disabled
                           style="width:220px;">

                </div>

            </div>

            <div class="card-body table-responsive p-0">

                <table class="table table-hover table-striped">

                    <thead>

                        <tr>

                            <th width="100">ID</th>
                            <th>Department Name</th>
                            <th width="220">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @item.DepartmentId
                                    </td>

                                    <td>
                                        <i class="fas fa-building text-primary"></i>
                                        @item.DepartmentName
                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.DepartmentId"
                                           class="btn btn-info btn-sm">

                                            <i class="fas fa-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.DepartmentId"
                                           class="btn btn-warning btn-sm">

                                            <i class="fas fa-edit"></i>

                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.DepartmentId"
                                           class="btn btn-danger btn-sm">

                                            <i class="fas fa-trash"></i>

                                        </a>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3" class="text-center text-muted p-4">

                                    <i class="fas fa-folder-open fa-2x mb-2"></i>

                                    <br />

                                    No Departments Found

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <div class="card-footer clearfix">

                <small class="text-muted">

                    Showing
                    <strong>@Model.Count()</strong>
                    Department(s)

                </small>

            </div>

        </div>

    </div>

</section>