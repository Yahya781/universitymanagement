@model IEnumerable<universitymanagementsystem.Models.Teacher>

@{
    ViewData["Title"] = "Teachers";
}

<style>
    .sms-page {
        --sms-border: #edf0f3;
        --sms-muted: #8a94a6;
        --sms-ink: #1f2430;
    }

        .sms-page .card {
            border: 1px solid var(--sms-border);
            border-radius: 0.9rem;
        }

        .sms-page .form-control,
        .sms-page .form-select {
            border-radius: 0.6rem;
            border-color: var(--sms-border);
        }

            .sms-page .form-control:focus,
            .sms-page .form-select:focus {
                box-shadow: 0 0 0 0.15rem rgba(13, 110, 253, 0.12);
                border-color: #b6c8f2;
            }

        .sms-page .btn {
            border-radius: 0.6rem;
            font-weight: 500;
        }

        .sms-page .btn-icon {
            width: 34px;
            height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 0.55rem;
            padding: 0;
        }

        .sms-page .table thead th {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            color: var(--sms-muted);
            font-weight: 600;
            border-bottom: 1px solid var(--sms-border);
            background: #fafbfc;
        }

        .sms-page .table td {
            border-bottom: 1px solid var(--sms-border);
            color: var(--sms-ink);
            vertical-align: middle;
        }

        .sms-page .table > :not(caption) > * > * {
            box-shadow: none;
        }

        .sms-page .table-hover tbody tr:hover {
            background-color: #f7f9fc;
        }

        .sms-page .header-link {
            color: var(--sms-muted);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }

            .sms-page .header-link:hover {
                color: var(--sms-ink);
            }

        .sms-page .badge-soft {
            font-weight: 500;
            font-size: 0.72rem;
            padding: 0.4em 0.7em;
            border-radius: 0.5rem;
        }

        .sms-page .avatar-chip {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #eef1f6;
            color: #55617a;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .sms-page .table-scroll {
            max-height: 620px;
        }

        .sms-page .stat-pill {
            font-size: 0.75rem;
            color: var(--sms-muted);
            background: #f5f6f8;
            border-radius: 2rem;
            padding: 0.35rem 0.9rem;
        }
</style>

<div class="sms-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success d-flex align-items-center border-0 rounded-3 py-2 px-3 mb-4" role="alert" style="background:#eaf7ee; color:#1e7a3d;">
            <i class="bi bi-check-circle-fill me-2"></i>
            <div class="flex-grow-1 small">@TempData["Success"]</div>
            <button type="button" class="btn-close small" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h4 fw-semibold mb-1" style="color: var(--sms-ink);">Teacher Management</h1>
            <div class="text-muted small">Manage faculty records, designations and departments</div>
        </div>

        <a asp-action="Create" class="btn btn-dark d-inline-flex align-items-center gap-2 px-3 py-2">
            <i class="bi bi-plus-lg"></i> Create New Teacher
        </a>
    </div>

    <!-- Search -->
    <div class="card mb-4">
        <div class="card-body p-3 p-md-4">
            <form asp-action="Index" method="get">
                <div class="row g-2 align-items-center">

                    <div class="col-12 col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0" style="border-color: var(--sms-border); border-radius: 0.6rem 0 0 0.6rem;">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text"
                                   name="searchString"
                                   class="form-control border-start-0"
                                   style="border-radius: 0 0.6rem 0.6rem 0;"
                                   placeholder="Search by name or email"
                                   value="@Context.Request.Query["searchString"]" />
                        </div>
                    </div>

                    <div class="col-12 col-md-4">
                        <select name="departmentId"
                                class="form-select"
                                asp-items="ViewBag.Departments">

                            <option value="">All departments</option>

                        </select>
                    </div>

                    <div class="col-6 col-md-auto">
                        <button type="submit" class="btn btn-dark w-100 px-3">
                            Search
                        </button>
                    </div>

                    <div class="col-6 col-md-auto">
                        <a asp-action="Index" class="btn btn-light border w-100 px-3">
                            Clear
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
            <span class="fw-semibold" style="color: var(--sms-ink);">All Teachers</span>
            <span class="stat-pill">@Model.Count() total</span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive table-scroll">
                <table class="table table-hover mb-0">
                    <thead style="position: sticky; top: 0; z-index: 1;">
                        <tr>
                            <th>
                                <a class="header-link"
                                   asp-action="Index"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-departmentId="@Context.Request.Query["departmentId"]"
                                   asp-route-sortOrder="@ViewBag.FirstNameSort">
                                    Teacher <i class="bi bi-chevron-expand" style="font-size:0.6rem;"></i>
                                </a>
                            </th>
                            <th>
                                <a class="header-link"
                                   asp-action="Index"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-departmentId="@Context.Request.Query["departmentId"]"
                                   asp-route-sortOrder="@ViewBag.EmailSort">
                                    Email <i class="bi bi-chevron-expand" style="font-size:0.6rem;"></i>
                                </a>
                            </th>
                            <th>@Html.DisplayNameFor(model => model.Phone)</th>
                            <th>
                                <a class="header-link"
                                   asp-action="Index"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-departmentId="@Context.Request.Query["departmentId"]"
                                   asp-route-sortOrder="@ViewBag.DesignationSort">
                                    Designation <i class="bi bi-chevron-expand" style="font-size:0.6rem;"></i>
                                </a>
                            </th>
                            <th>
                                <a class="header-link"
                                   asp-action="Index"
                                   asp-route-searchString="@Context.Request.Query["searchString"]"
                                   asp-route-departmentId="@Context.Request.Query["departmentId"]"
                                   asp-route-sortOrder="@ViewBag.DepartmentSort">
                                    Department <i class="bi bi-chevron-expand" style="font-size:0.6rem;"></i>
                                </a>
                            </th>
                            <th class="text-end pe-3">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar-chip">
                                            @{
                                                var initials = ((item.FirstName?.Length > 0 ? item.FirstName[0].ToString() : "") +
                                                (item.LastName?.Length > 0 ? item.LastName[0].ToString() : "")).ToUpper();
                                            }
                                            @initials
                                        </span>
                                        <div>
                                            <div class="fw-medium" style="line-height:1.1;">
                                                @Html.DisplayFor(modelItem => item.FirstName) @Html.DisplayFor(modelItem => item.LastName)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="small">@Html.DisplayFor(modelItem => item.Email)</span>
                                </td>
                                <td>
                                    <span class="small text-muted">@Html.DisplayFor(modelItem => item.Phone)</span>
                                </td>
                                <td>
                                    <span class="badge-soft" style="background:#eaf1ff; color:#3457d5;">
                                        @Html.DisplayFor(modelItem => item.Designation)
                                    </span>
                                </td>
                                <td>
                                    <span class="small">@Html.DisplayFor(modelItem => item.Department.DepartmentName)</span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-inline-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@item.TeacherId"
                                           class="btn btn-icon btn-outline-warning" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.TeacherId"
                                           class="btn btn-icon btn-outline-primary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.TeacherId"
                                           class="btn btn-icon btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>