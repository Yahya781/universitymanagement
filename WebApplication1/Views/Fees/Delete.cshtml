@model universitymanagementsystem.Models.Fee

@{
    ViewData["Title"] = "Delete Fee";
}

<div class="content-header">
    <div class="container-fluid">

        <div class="row mb-2">

            <div class="col-sm-6">
                <h2>
                    <i class="fas fa-trash"></i>
                    Delete Fee
                </h2>
            </div>

            <div class="col-sm-6 text-right">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back
                </a>
            </div>

        </div>

    </div>
</div>

<section class="content">

    <div class="container-fluid">

        <div class="row justify-content-center">

            <div class="col-md-8">

                <div class="card card-danger">

                    <div class="card-header">

                        <h3 class="card-title">
                            Confirm Delete
                        </h3>

                    </div>

                    <div class="card-body">

                        <div class="alert alert-danger">
                            <h5>
                                <i class="icon fas fa-exclamation-triangle"></i>
                                Warning!
                            </h5>

                            Are you sure you want to delete this fee record?
                        </div>

                        <dl class="row">

                            <dt class="col-sm-4">
                                Student
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Student.FirstName
                            </dd>

                            <dt class="col-sm-4">
                                Amount
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Amount
                            </dd>

                            <dt class="col-sm-4">
                                Due Date
                            </dt>

                            <dd class="col-sm-8">
                                @Model.DueDate.ToShortDateString()
                            </dd>

                            <dt class="col-sm-4">
                                Paid Date
                            </dt>

                            <dd class="col-sm-8">
                                @(Model.PaidDate.HasValue ? Model.PaidDate.Value.ToShortDateString() : "-")
                            </dd>

                            <dt class="col-sm-4">
                                Status
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Status
                            </dd>

                            <dt class="col-sm-4">
                                Remarks
                            </dt>

                            <dd class="col-sm-8">
                                @Model.Remarks
                            </dd>

                        </dl>

                    </div>

                    <div class="card-footer">

                        <form asp-action="Delete">

                            <input type="hidden" asp-for="FeeId" />

                            <button type="submit" class="btn btn-danger">
                                <i class="fas fa-trash"></i>
                                Delete
                            </button>

                            <a asp-action="Index" class="btn btn-secondary">
                                Cancel
                            </a>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>