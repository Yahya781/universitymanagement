@model IEnumerable<universitymanagementsystem.Models.Fee>

@{
    ViewData["Title"] = "Fees";
}

<div class="content-header">
    <div class="container-fluid">

        <div class="row mb-2">

            <div class="col-sm-6">
                <h2>
                    <i class="fas fa-money-bill-wave"></i>
                    Fees Management
                </h2>
            </div>

            <div class="col-sm-6 text-right">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i>
                    Add Fee
                </a>
            </div>

        </div>

        <div class="card mb-4">
            <div class="card-body">
                <form asp-action="Index" method="get">
                    <div class="row">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <select name="studentId" class="form-control" asp-items="ViewBag.Students">
                                <option value="">-- All Students --</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3 mb-md-0">
                            <select name="status" class="form-control" asp-items="ViewBag.Statuses">
                                <option value="">-- All Statuses --</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <button type="submit" class="btn btn-secondary">Filter</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

<section class="content">

    <div class="container-fluid">

        <div class="card">

            <div class="card-header">
                <h3 class="card-title">
                    Fees List
                </h3>
            </div>

            <div class="card-body table-responsive p-0">

                <table class="table table-hover">

                    <thead class="table-light">

                        <tr>
                            <th>Student</th>
                            <th>Amount</th>
                            <th>Due Date</th>
                            <th>Paid Date</th>
                            <th>Status</th>
                            <th>Remarks</th>
                            <th width="180">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@item.Student.FirstName</td>

                                <td>@item.Amount</td>

                                <td>@item.DueDate.ToShortDateString()</td>

                                <td>
                                    @(item.PaidDate.HasValue
                                        ? item.PaidDate.Value.ToShortDateString()
                                        : "-")
                                </td>

                                <td>
                                    <span class="badge badge-info">
                                        @item.Status
                                    </span>
                                </td>

                                <td>@item.Remarks</td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.FeeId"
                                       class="btn btn-info btn-sm">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.FeeId"
                                       class="btn btn-warning btn-sm">
                                        <i class="fas fa-edit"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.FeeId"
                                       class="btn btn-danger btn-sm">
                                        <i class="fas fa-trash"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</section>