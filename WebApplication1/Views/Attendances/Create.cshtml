@model universitymanagementsystem.Models.AttendancePickerViewModel

@{
    ViewData["Title"] = "Mark Attendance";
}

<h2>Mark Attendance</h2>
<p class="text-muted">Select a course and date to load the student roster.</p>

<form asp-action="Create" method="post" class="row g-3" style="max-width: 500px;">
    <div class="col-12">
        <label class="form-label">Course</label>
        <select asp-for="CourseId" class="form-select" asp-items="@(ViewData["CourseId"] as SelectList)">
            <option value="">-- Select Course --</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label class="form-label">Date</label>
        <input asp-for="AttendanceDate" type="date" class="form-control" />
        <span asp-validation-for="AttendanceDate" class="text-danger"></span>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Load Roster</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}