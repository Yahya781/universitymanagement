@model universitymanagementsystem.Models.Attendance

@{
    ViewData["Title"] = "Edit Attendance";
}

<h2>Edit Attendance</h2>

<div class="mb-3">
    <strong>Student:</strong> @Model.Enrollment.Student.FirstName @Model.Enrollment.Student.LastName (@Model.Enrollment.Student.RegistrationNo)<br />
    <strong>Course:</strong> @Model.Enrollment.Course.CourseName<br />
    <strong>Date:</strong> @Model.AttendanceDate.ToString("dd MMM yyyy")
</div>

<form asp-action="Edit" method="post" style="max-width: 400px;">
    <input type="hidden" asp-for="AttendanceId" />
    <input type="hidden" asp-for="EnrollmentId" />
    <input type="hidden" asp-for="AttendanceDate" />

    <div class="mb-3">
        <label class="form-label">Status</label>
        <select asp-for="Status" class="form-select">
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
            <option value="Leave">Leave</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>