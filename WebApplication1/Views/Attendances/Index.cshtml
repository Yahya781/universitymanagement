@model IEnumerable<universitymanagementsystem.Models.Attendance>

@{
    ViewData["Title"] = "Attendance Records";
}

<h2>Attendance Records</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">Mark New Attendance</a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-auto">
        <label class="form-label">Course</label>
        <select name="courseId" class="form-select" asp-items="ViewBag.Courses">
            <option value="">-- All Courses --</option>
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Date</label>
        <input type="date" name="date" class="form-control"
               value="@(ViewBag.SelectedDate != null ? ((DateOnly)ViewBag.SelectedDate).ToString("yyyy-MM-dd") : "")" />
    </div>
    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-secondary">Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Reg No.</th>
            <th>Student Name</th>
            <th>Course</th>
            <th>Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Enrollment.Student.RegistrationNo</td>
                <td>@item.Enrollment.Student.FirstName @item.Enrollment.Student.LastName</td>
                <td>@item.Enrollment.Course.CourseName</td>
                <td>@item.AttendanceDate.ToString("dd MMM yyyy")</td>
                <td>
                    @{
                        var badgeClass = item.Status switch
                        {
                            "Present" => "bg-success",
                            "Absent" => "bg-danger",
                            "Leave" => "bg-warning text-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @badgeClass">@item.Status</span>
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-primary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.AttendanceId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No attendance records found for the selected filters.</p>
}