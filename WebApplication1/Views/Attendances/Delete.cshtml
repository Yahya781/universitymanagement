@model universitymanagementsystem.Models.Attendance

@{
    ViewData["Title"] = "Delete Attendance";
}

<h2>Delete Attendance</h2>
<div class="alert alert-danger">Are you sure you want to delete this record?</div>

<dl class="row">
    <dt class="col-sm-3">Student</dt>
    <dd class="col-sm-9">@Model.Enrollment.Student.FirstName @Model.Enrollment.Student.LastName (@Model.Enrollment.Student.RegistrationNo)</dd>

    <dt class="col-sm-3">Course</dt>
    <dd class="col-sm-9">@Model.Enrollment.Course.CourseName</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">@Model.AttendanceDate.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">@Model.Status</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="AttendanceId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>