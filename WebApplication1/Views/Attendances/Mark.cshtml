@model universitymanagementsystem.Models.MarkAttendanceViewModel

@{
    ViewData["Title"] = "Mark Attendance - " + Model.CourseName;
}

<h2>Mark Attendance</h2>
<h5 class="text-muted">@Model.CourseName &nbsp;|&nbsp; @Model.AttendanceDate.ToString("dd MMM yyyy")</h5>

<form asp-action="Mark" method="post">
    <input type="hidden" asp-for="CourseId" />
    <input type="hidden" asp-for="CourseName" />
    <input type="hidden" asp-for="AttendanceDate" />

    @if (!Model.Students.Any())
    {
        <div class="alert alert-warning mt-3">No students are enrolled in this course.</div>
    }
    else
    {
        <table class="table table-bordered mt-3">
            <thead class="table-light">
                <tr>
                    <th>Reg No.</th>
                    <th>Student Name</th>
                    <th style="width: 220px;">Status</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Students.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.Students[i].RegistrationNo
                            <input type="hidden" asp-for="Students[i].EnrollmentId" />
                            <input type="hidden" asp-for="Students[i].RegistrationNo" />
                            <input type="hidden" asp-for="Students[i].FullName" />
                        </td>
                        <td>@Model.Students[i].FullName</td>
                        <td>
                            <select asp-for="Students[i].Status" class="form-select">
                                <option value="Present">Present</option>
                                <option value="Absent">Absent</option>
                                <option value="Leave">Leave</option>
                            </select>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-success">Save Attendance</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    }
</form>