@{
    ViewData["Title"] = "Dashboard";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Dashboard</h1>
            </div>
        </div>
    </div>
</div>

<div class="content">
    <div class="container-fluid">
    </div>
</div>

<div class="content">
    <div class="container-fluid">

        <div class="row">

            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3>250</h3>
                        <p>Students</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-user-graduate"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3>35</h3>
                        <p>Teachers</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-chalkboard-teacher"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3>20</h3>
                        <p>Courses</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-book"></i>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3>6</h3>
                        <p>Departments</p>
                    </div>
                    <div class="icon">
                        <i class="fas fa-building"></i>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<div class="row">

    <div class="col-md-12">
        <div class="card">

            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-clipboard-check mr-2"></i>
                    Today's Attendance
                </h3>
            </div>

            <div class="card-body">
                <h2>92%</h2>
                <p>Overall attendance for today.</p>
            </div>

        </div>
    </div>

</div>

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Recent Student Registrations</h3>
    </div>

    <div class="card-body p-0">

        <div class="row mt-4">

            <div class="col-12">

                <div class="card">

                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-user-graduate"></i>
                            Recent Student Registrations
                        </h3>
                    </div>

                    <div class="card-body table-responsive p-0">

                        <table class="table table-hover text-nowrap">

                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Name</th>
                                    <th>Department</th>
                                    <th>Semester</th>
                                    <th>Date Registered</th>
                                </tr>
                            </thead>

                            <tbody>

                                <tr>
                                    <td>1001</td>
                                    <td>Ali Khan</td>
                                    <td>Computer Science</td>
                                    <td>5</td>
                                    <td>20 Jul 2026</td>
                                </tr>

                                <tr>
                                    <td>1002</td>
                                    <td>Ahmed Raza</td>
                                    <td>Software Engineering</td>
                                    <td>7</td>
                                    <td>19 Jul 2026</td>
                                </tr>

                                <tr>
                                    <td>1003</td>
                                    <td>Fatima Noor</td>
                                    <td>Artificial Intelligence</td>
                                    <td>3</td>
                                    <td>18 Jul 2026</td>
                                </tr>

                                <tr>
                                    <td>1004</td>
                                    <td>Zain Ali</td>
                                    <td>Business Administration</td>
                                    <td>2</td>
                                    <td>18 Jul 2026</td>
                                </tr>

                                <tr>
                                    <td>1005</td>
                                    <td>Sara Ahmed</td>
                                    <td>Computer Science</td>
                                    <td>1</td>
                                    <td>17 Jul 2026</td>
                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

<div class="row mt-4">

    <div class="col-12">

        <div class="card">

            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-bolt"></i>
                    Quick Actions
                </h3>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Student" asp-action="Index" class="btn btn-primary btn-lg btn-block">
                            <i class="fas fa-user-plus"></i> Add Student
                        </a>
                    </div>

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Teacher" asp-action="Index" class="btn btn-success btn-lg btn-block">
                            <i class="fas fa-chalkboard-teacher"></i> Add Teacher
                        </a>
                    </div>

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Course" asp-action="Index" class="btn btn-warning btn-lg btn-block">
                            <i class="fas fa-book"></i> Add Course
                        </a>
                    </div>

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Department" asp-action="Index" class="btn btn-info btn-lg btn-block">
                            <i class="fas fa-building"></i> Add Department
                        </a>
                    </div>

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Attendance" asp-action="Index" class="btn btn-secondary btn-lg btn-block">
                            <i class="fas fa-clipboard-check"></i> Attendance
                        </a>
                    </div>

                    <div class="col-md-4 mb-3">
                        <a asp-controller="Fees" asp-action="Index" class="btn btn-danger btn-lg btn-block">
                            <i class="fas fa-money-bill-wave"></i> Manage Fees
                        </a>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>